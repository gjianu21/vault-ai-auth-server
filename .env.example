# Copy this file to .env and fill in the values. Never commit .env.
# The same file is read by docker compose and by Spring Boot.

# --- Oracle (docker) ---
ORACLE_SYS_PASSWORD=change-me-sys
VAULT_AUTH_DB_PASSWORD=change-me-auth
VAULT_APP_DB_PASSWORD=change-me-app

# --- OAuth2 client used by vault-ai-be ---
OAUTH2_CLIENT_SECRET=change-me-client-secret

# --- Shared secret for internal calls between auth-server and vault-ai-be ---
INTERNAL_API_KEY=change-me-internal-key

# --- JWT signing key (optional on the local profile; a temporary key is generated if empty) ---
JWK_KEYSTORE_PATH=
JWK_KEYSTORE_PASSWORD=
JWK_KEY_ALIAS=vault-ai-jwt