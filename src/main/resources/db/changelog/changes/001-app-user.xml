<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-app-user" author="jianu">
        <createTable tableName="app_user">
            <column name="id" type="RAW(16)">
                <constraints primaryKey="true" primaryKeyName="pk_app_user" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR2(320)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_app_user_email"/>
            </column>
            <column name="password_hash" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>
            <column name="user_role" type="VARCHAR2(20)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="NUMBER(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>