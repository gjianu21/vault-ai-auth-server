<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Column names required by Spring's JdbcRegisteredClientRepository -->
    <changeSet id="004-create-oauth2-registered-client" author="jianu">
        <createTable tableName="oauth2_registered_client">
            <column name="id" type="VARCHAR2(100)">
                <constraints primaryKey="true" primaryKeyName="pk_oauth2_registered_client" nullable="false"/>
            </column>
            <column name="client_id" type="VARCHAR2(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_oauth2_client_client_id"/>
            </column>
            <column name="client_id_issued_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="client_secret" type="VARCHAR2(200)"/>
            <column name="client_secret_expires_at" type="TIMESTAMP"/>
            <column name="client_name" type="VARCHAR2(200)">
                <constraints nullable="false"/>
            </column>
            <column name="client_authentication_methods" type="VARCHAR2(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="authorization_grant_types" type="VARCHAR2(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="redirect_uris" type="VARCHAR2(1000)"/>
            <column name="post_logout_redirect_uris" type="VARCHAR2(1000)"/>
            <column name="scopes" type="VARCHAR2(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="client_settings" type="VARCHAR2(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="token_settings" type="VARCHAR2(2000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>